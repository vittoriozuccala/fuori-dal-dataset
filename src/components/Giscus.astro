---
// Componente commenti Giscus per "Fuori dal Dataset".
// I valori repo/repoId/categoryId vanno aggiornati dopo la creazione del repo
// e l'abilitazione di GitHub Discussions (vedi giscus.app per generarli).
const repo = "vittoriozuccala/fuori-dal-dataset";
const repoId = "R_kgDOUKAprQ";
const category = "Announcements";
const categoryId = "DIC_kwDOUKAprc4DEmB-";
const mapping = "pathname";
const theme = "preferred_color_scheme";
---

<div class="giscus-wrapper">
  <h2 class="giscus-title">Commenti</h2>
  <div class="giscus"></div>
  <script
    src="https://giscus.app/client.js"
    data-repo={repo}
    data-repo-id={repoId}
    data-category={category}
    data-category-id={categoryId}
    data-mapping={mapping}
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme={theme}
    data-lang="it"
    crossorigin="anonymous"
    async
  ></script>
</div>

<style>
  .giscus-wrapper {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color, #e5e7eb);
  }
  .giscus-title {
    font-size: 1.35rem;
    margin-bottom: 1rem;
  }
  .giscus {
    width: 100%;
  }
</style>
